# WordPress Database Configuration
DB_NAME=organicstore
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpassword
DB_HOST=db:3306
DB_TABLE_PREFIX=wp_

# WordPress Site Configuration
WP_HOME=http://organicstore.local
WP_SITEURL=http://organicstore.local
WP_DEBUG=1

# WordPress Admin User (for initial setup)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_this_password
WP_ADMIN_EMAIL=admin@organicstore.local

# WordPress REST API Authentication
# Application Password will be generated via WP-CLI after installation
# Format: username:application_password
# WP_API_AUTH=api_user:xxxx xxxx xxxx xxxx xxxx xxxx
WP_API_BASE_URL=http://organicstore.local/wp-json

# Environment
ENVIRONMENT=development
