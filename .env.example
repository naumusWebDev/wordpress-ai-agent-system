# =============================================================================
# WordPress AI Agent System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your project values.
# Never commit .env to version control.
# =============================================================================

# Project name (used for Docker container naming)
COMPOSE_PROJECT_NAME=myproject

# WordPress Database Configuration
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpassword
DB_HOST=db:3306
DB_TABLE_PREFIX=wp_

# WordPress Site Configuration
WP_HOME=http://myproject.local
WP_SITEURL=http://myproject.local
WP_DEBUG=1

# WordPress Admin User (for initial setup)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_this_password
WP_ADMIN_EMAIL=admin@myproject.local

# WordPress REST API Authentication
# Generate an Application Password from: Users → Profile → Application Passwords
# Requires WP_ENVIRONMENT_TYPE=local or HTTPS
WP_API_BASE_URL=http://myproject.local/wp-json
WP_API_USER=admin
WP_API_PASSWORD=your_application_password_here

# WP-CLI Configuration (for Local WP / WSL setups)
# WP_PATH=/mnt/c/Users/YourName/Local Sites/myproject/app/public

# Environment
ENVIRONMENT=development
